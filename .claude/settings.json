{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm run build *)",
			"Bash(npm run lint:js *)",
			"Bash(npm run lint:css *)",
			"Bash(npm run lint:php *)",
			"Bash(npm run format *)",
			"Bash(npm run test:unit *)",
			"Bash(npm run plugin-zip *)",
			"Bash(npx wp-scripts lint-js *)",
			"Bash(npx wp-scripts lint-style *)",
			"Bash(composer cs *)",
			"Bash(composer cbf *)",
			"Bash(vendor/bin/phpcs *)",
			"Bash(vendor/bin/phpcbf *)",
			"Bash(gh issue view *)",
			"Bash(gh issue list *)",
			"Bash(gh pr view *)",
			"Bash(gh pr diff *)",
			"Bash(gh pr checks *)",
			"Bash(gh pr list *)"
		],
		"deny": [
			"Edit(/build/**)",
			"Bash(gh pr merge *)",
			"Bash(git push*--force*)",
			"Bash(git push* -f*)",
			"Bash(git push* main)",
			"Bash(git push*:main)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-file.sh"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/test-on-stop.sh"
					}
				]
			}
		]
	}
}
