<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards">
	<rule ref="WordPress">
		<!-- Exclude specific sniffs if needed -->
		<exclude name="WordPress.Files.FileName" />
	</rule>

	<!-- Every translatable string must use the plugin's text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="mermaid-blocks"/>
			</property>
		</properties>
	</rule>

	<!-- Keep in sync with "Requires at least" and "Requires PHP" in mermaid-blocks.php. -->
	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Paths to scan -->
	<file>.</file>
	<arg name="extensions" value="php"/>

	<!-- Ignore these directories -->
	<exclude-pattern>assets/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>
</ruleset>
