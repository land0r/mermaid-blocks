{
	"name": "land0r/graphdraw",
	"description": "Mermaid diagrams in the WordPress block editor.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"autoload": {
		"psr-4": {
			"GraphDraw\\": "includes/"
		}
	},
	"repositories": [
		{
			"type": "package",
			"package": {
				"name": "wordpress-plugin/elementor",
				"version": "4.3.5",
				"dist": {
					"type": "zip",
					"url": "https://downloads.wordpress.org/plugin/elementor.4.3.5.zip",
					"shasum": "41309f1bd27df5cb014f6dc16b229a477e6fc3ce"
				}
			}
		}
	],
	"require-dev": {
		"wordpress-plugin/elementor": "4.3.5",
		"wp-coding-standards/wpcs": "^3.4.1",
		"squizlabs/php_codesniffer": "^3.13.6",
		"phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
		"phpcompatibility/php-compatibility": "^10.0@alpha",
		"phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0",
		"wp-phpunit/wp-phpunit": "^7.1",
		"roots/wordpress-no-content": "^7.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4"
		},
		"platform-check": false
	},
	"scripts": {
		"cs": "phpcs --extensions=php .",
		"cbf": "phpcbf --extensions=php .",
		"cs:config": "phpcs --config-show",
		"test": [
			"phpunit",
			"@test:elementor"
		],
		"test:elementor": "phpunit -c phpunit-elementor.xml.dist"
	}
}
