{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mermaid-blocks/diagram",
	"version": "1.1.0",
	"title": "Mermaid Diagram",
	"category": "widgets",
	"description": "MermaidJS diagram: flowcharts, Gantt charts, sequence diagrams, and more.",
	"supports": {
		"html": false,
		"align": [ "center", "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"code": {
			"type": "string"
		},
		"zoom": {
			"type": "boolean",
			"default": false
		},
		"download": {
			"type": "boolean",
			"default": false
		},
		"copy": {
			"type": "boolean",
			"default": false
		},
		"fullscreen": {
			"type": "boolean",
			"default": false
		},
		"theme": {
			"type": "string"
		},
		"caption": {
			"type": "string"
		},
		"accTitle": {
			"type": "string"
		},
		"accDescr": {
			"type": "string"
		}
	},
	"textdomain": "mermaid-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "mermaid-blocks-diagram",
	"viewScript": "mermaid-blocks-diagram"
}
