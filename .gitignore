node_modules/
vendor/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Output of `npm pack`
*.tgz

# Output of `wp-scripts plugin-zip`
*.zip

# dotenv environment variables file
.env

# Personal Claude Code settings and notes
.claude/settings.local.json
CLAUDE.local.md
